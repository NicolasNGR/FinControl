{
  "tipo": "Redis",
  "descricao": "Schema lógico usado por database.py. O frontend estatico ainda usa localStorage como fallback de demonstracao.",
  "chaves": {
    "emails": {
      "tipo": "Hash",
      "campos": {
        "email": "usuario_id"
      }
    },
    "usuario:{id}": {
      "tipo": "Hash",
      "campos": {
        "id": "String",
        "nome": "String",
        "email": "String",
        "senha": "SHA-256",
        "role": "user|admin",
        "ativo": "true|false",
        "criado_em": "ISO datetime"
      }
    },
    "sessao:{token}": {
      "tipo": "String",
      "valor": "usuario_id",
      "ttl": "24 horas"
    },
    "usuario:{id}:lancamentos": {
      "tipo": "Set",
      "valor": "ids dos lancamentos do usuario"
    },
    "lancamento:{id}": {
      "tipo": "Hash",
      "campos": {
        "id": "String",
        "usuario_id": "String",
        "descricao": "String",
        "categoria_id": "String",
        "tipo": "receita|despesa",
        "valor": "Number",
        "data": "YYYY-MM-DD"
      }
    }
  },
  "api": {
    "iniciar": "python database.py api",
    "endpoints": [
      "GET /api/health",
      "POST /api/auth/register",
      "POST /api/auth/login",
      "GET /api/usuarios"
    ]
  }
}
